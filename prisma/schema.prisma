  updatedAt   DateTime         @updatedAt
  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
}

/// Capa de expediente municipal sobre una reunion. 1:1 con un Meeting de
/// kind=PUBLIC_HEARING. Vive aparte y no dentro de Meeting porque este
/// vocabulario (expediente, ordenanza, area impulsora) solo aplica a las
/// audiencias: Gabinete y las comisiones tecnicas usan el mismo Meeting sin nada
/// de esto.
model HearingRecord {
  id                       String                 @id @default(cuid())
  meetingId                String                 @unique
  /// Ciclo de vida de la audiencia como acto publico. NO confundir con
  /// Meeting.status, que es ProcessingStatus y describe el procesamiento del
  /// audio. Una audiencia FINALIZADA puede tener el audio en ERROR: son dos ejes
  /// distintos y colapsarlos deja estados sin sentido.
  lifecycle                HearingLifecycle       @default(PROGRAMADA)
  modality                 HearingModality        @default(PRESENCIAL)
  mainTopic                String
  secondaryTopics          String[]
  recordNumber             String
  recordTitle              String
  relatedProposal          String?
  proposalOrigin           HearingProposalOrigin  @default(CONCEJO)
  /// Etiqueta exacta del origen elegida en la ficha ("Ejecutivo municipal",
  /// "Área técnica"...). El enum proposalOrigin es mas grueso; esta columna
  /// conserva lo que el operador eligio sin forzarlo a 3 valores.
  proposalSource           String?
  promotingArea            String?
  recordStatus             String?
  recordDocument           String?
  relatedArticles          String[]
  projectId                String?
  /// Participacion declarada en la ficha (texto libre del operador). La
  /// participacion detectada por IA en la transcripcion vive aparte, en
  /// MeetingParticipant: una es carga manual del acta, la otra evidencia.
  participantsText         String?
  institution              String?
  participantRole          String?
  actorType                String?
  intervention             String?
  /// Observaciones del acta como conjunto (las por-tema van en
  /// HearingObservedTopic, que las tiene por fila).
  technicalObservation     String?
  citizenObservation       String?
  /// Importancia que el operador le dio a los temas observados. Vive aca y no
  /// solo en las filas de HearingObservedTopic porque la ficha tiene un unico
  /// selector: sin temas cargados no habia donde guardarla y volvia a "Medio".
  topicsImportance         TopicImportance?
  /// Conclusiones del acta. Son campos propios y no MeetingAnalysis porque las
  /// firma una persona: si vivieran en el analisis, volver a correr el modelo
  /// pisaria lo que un funcionario ya valido.
  conclusionsSummary       String?
  agreements               String?
  disagreements            String?
  nextSteps                String?
  technicalRecommendations String?
  decisions                String?
  proposalStatusAfter      String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  meeting                  Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project                  Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  observedTopics           HearingObservedTopic[]
  documents                HearingDocument[]
  debateMessages           HearingDebateMessage[]
  contributions            HearingContribution[]

  @@index([lifecycle])
  @@index([projectId])
}

model HearingObservedTopic {
  id                   String          @id @default(cuid())
  hearingRecordId      String
  topic                String
  description          String
  importance           TopicImportance @default(MEDIO)
  relatedArticle       String?
  relatedProposal      String?
  technicalObservation String?
  citizenObservation   String?
  createdAt            DateTime        @default(now())
  hearingRecord        HearingRecord   @relation(fields: [hearingRecordId], references: [id], onDelete: Cascade)

  @@index([hearingRecordId])
}

/// Documentacion del expediente (ordenanzas, informes, planos). El audio y el
/// video no van aca: esos son MeetingMedia, que ademas tiene estado de
/// procesamiento.
model HearingDocument {
  id              String        @id @default(cuid())
  hearingRecordId String
  name            String
  type            String
  url             String?
  description     String?
  uploadedBy      String?
  uploadedAt      DateTime      @default(now())
  /// Ruta del objeto en Supabase Storage (bucket de audiencias): permite borrar
  /// el archivo real cuando se elimina el registro. url es el link publico.
  storagePath     String?
  sizeBytes       Int?
  hearingRecord   HearingRecord @relation(fields: [hearingRecordId], references: [id], onDelete: Cascade)

  @@index([hearingRecordId])
}

model HearingDebateMessage {
  id              String        @id @default(cuid())
  hearingRecordId String
  authorName      String
  content         String
  createdAt       DateTime      @default(now())
  hearingRecord   HearingRecord @relation(fields: [hearingRecordId], references: [id], onDelete: Cascade)

  @@index([hearingRecordId, createdAt])
}

model HearingContribution {
  id              String        @id @default(cuid())
  hearingRecordId String
  participantName String
  content         String
  fileNames       String[]
  createdAt       DateTime      @default(now())
  hearingRecord   HearingRecord @relation(fields: [hearingRecordId], references: [id], onDelete: Cascade)

  @@index([hearingRecordId, createdAt])
}

model CpuConversation {
