generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // La app corre contra el pooler de Supabase en modo TRANSACCION (puerto 6543,
  // con pgbouncer=true). Es el unico que aguanta serverless: en modo sesion
  // (5432) cada cliente reserva una conexion real de Postgres y el tope son 15,
  // asi que con unas pocas lambdas tibias la base empieza a rechazar consultas
  // con EMAXCONNSESSION.
  url = env("DATABASE_URL")
  // Las migraciones NO pueden ir por el pooler de transacciones: necesitan una
  // conexion de sesion. DIRECT_URL es la misma cadena con el puerto 5432.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  /// Apellido separado del nombre. Nullable a propósito: las cuentas previas
  /// tienen todo en `name` y partirlo automáticamente es lotería; lo completa
  /// un admin o llegará como dato canónico desde Cidituc.
  lastName     String?
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  /// Documento del vecino. Se pide una sola vez, al registrarse.
  dni          String?    @unique
  /// Fecha de nacimiento: el registro exige 18 años cumplidos.
  birthDate    DateTime?
  /// Profesión u ocupación declarada por el vecino.
  occupation   String?
  avatarUrl    String?
  lastLoginAt  DateTime?
  /// Identidad municipal. Queda vacío hasta que se active la integración Cidituc;
  /// cuando exista, es la prueba de que la cuenta fue validada contra el padrón.
  ciditucId         String?   @unique
  ciditucVerifiedAt DateTime?
  areaId       String?
  area         Area?       @relation(fields: [areaId], references: [id])
  dependencyId String?
  dependency   Dependency? @relation(fields: [dependencyId], references: [id])
  createdAt    DateTime   @default(now())
  proposals    Proposal[]
  comments     Comment[]
  votes        Vote[]
  projects     Project[]
  contributions CitizenContribution[]
  reforms      NormativeReform[]
  normOpinions NormOpinion[]
  normSupports NormSupport[]
  auditActions UserAuditLog[] @relation("AuditActor")
  auditEntries UserAuditLog[] @relation("AuditTarget")
  debatesCreated  Debate[]                @relation("DebatesCreated")
  debateArguments DebateArgument[]        @relation("DebateArguments")
  argumentsHidden DebateArgument[]        @relation("ArgumentsHidden")
  debateSupports  DebateArgumentSupport[] @relation("DebateSupports")

  @@index([role, status])
}

/// Foro interno de debates. Un debate es una pregunta urbana concreta,
/// opcionalmente anclada a una propuesta o proyecto de la cartera. Lo crean
/// administradores; el equipo interno participa con argumentos y adhesiones.
model Debate {
  id          String       @id @default(cuid())
  title       String
  /// Planteo/contexto: qué se discute y por qué ahora.
  context     String
  status      DebateStatus @default(OPEN)
  closesAt    DateTime?
  /// Audiencia de origen. Obligatoria al crear (lo exige la API); nullable en
  /// base solo por los debates previos a esta regla.
  meetingId   String?
  meeting     Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  proposalId  String?
  proposal    Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("DebatesCreated", fields: [createdById], references: [id])
  /// Análisis de Migue sobre la deliberación completa. Solo se genera con el
  /// debate CERRADO y a pedido de un administrador; se guarda para no
  /// recalcularlo en cada visita.
  analysis              Json?
  analysisAt            DateTime?
  analysisArgumentCount Int?
  analysisModel         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  arguments   DebateArgument[]

  @@index([status, createdAt])
}

model DebateArgument {
  id       String       @id @default(cuid())
  debateId String
  debate   Debate       @relation(fields: [debateId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?        @relation("DebateArguments", fields: [authorId], references: [id])
  stance   DebateStance
  content  String
  /// Respuesta de un solo nivel a otro argumento. El esquema lo soporta desde
  /// ya; la UI de respuestas llega en una fase posterior.
  parentId String?
  parent   DebateArgument?  @relation("ArgumentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DebateArgument[] @relation("ArgumentReplies")
  /// Moderación: se oculta con motivo, nunca se borra.
  status       DebateArgumentStatus @default(VISIBLE)
  hiddenById   String?
  hiddenBy     User?                @relation("ArgumentsHidden", fields: [hiddenById], references: [id])
  hiddenReason String?
  createdAt    DateTime             @default(now())
  supports     DebateArgumentSupport[]

  @@index([debateId, status, createdAt])
}

/// Adhesión ("+1") a un argumento: una por usuario por argumento. Es lo que
/// ordena los argumentos por peso en vez de por hora.
model DebateArgumentSupport {
  id         String         @id @default(cuid())
  argumentId String
  argument   DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation("DebateSupports", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([argumentId, userId])
}

/// Catálogo de áreas municipales (Planeamiento, Obras Públicas, etc.).
/// Tabla y no texto libre: los filtros por área dependen de que el nombre
/// sea único y estable.
model Area {
  id           String       @id @default(cuid())
  name         String       @unique
  createdAt    DateTime     @default(now())
  dependencies Dependency[]
  users        User[]
}

/// Dependencia (dirección/oficina) dentro de un área.
model Dependency {
  id        String   @id @default(cuid())
  name      String
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  users     User[]

  @@unique([areaId, name])
}

/// Bitácora de administración de usuarios. Cada mutación del módulo
/// Usuarios y Accesos escribe acá; nunca se borra ni se edita.
/// `action` es texto (no enum) para poder sumar acciones sin migrar;
/// los valores válidos viven tipados en lib/settings/audit.ts.
model UserAuditLog {
  id            String   @id @default(cuid())
  /// Admin que ejecutó la acción. Nullable: acciones del sistema (p. ej. un
  /// bloqueo automático) no tienen actor humano.
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id])
  targetUserId  String?
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id])
  action        String
  previousValue String?
  newValue      String?
  reason        String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Matriz rol -> permiso. Una fila es un permiso CONCEDIDO; la ausencia de fila
/// es denegación. La editan los administradores desde /admin/configuracion/permisos
/// y se resuelve UNA vez por request dentro de `getSessionUser()`, para que los
/// helpers de lib/auth/permissions sigan siendo síncronos.
///
/// `permission` es TEXT y no un enum, por la misma razón que `UserAuditLog.action`:
/// el catálogo tiene que poder crecer con un deploy, sin migrar un tipo de
/// Postgres. La fuente de verdad de las claves válidas es PERMISSION_CATALOG
/// (lib/auth/permissions.ts); una fila con una clave que ya no esté en el catálogo
/// se ignora al resolver, no rompe.
///
/// Sin columna de actor: quién cambió qué, con motivo, IP y dispositivo va a
/// UserAuditLog en la misma transacción, igual que en lib/settings/api/user-actions.ts.
model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  /// Un permiso por rol. Hace idempotente al seed de la migración y evita que dos
  /// administradores guardando a la vez dejen la misma concesión duplicada.
  /// Alcanza también como índice de lectura: la resolución por request filtra por
  /// `role`, que es el prefijo de esta clave compuesta.
  @@unique([role, permission])
}

/// Solicitudes de acceso al sistema interno. La estructura queda lista desde
/// ahora; empieza a poblarse cuando se active la integración Cidituc.
model AccessRequest {
  id            String              @id @default(cuid())
  firstName     String
  lastName      String
  dni           String
  email         String
  areaId        String?
  dependencyId  String?
  /// Estado de la cuenta en Cidituc al momento de solicitar (verificada, etc.).
  ciditucStatus String?
  requestedRole UserRole?
  status        AccessRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime            @default(now())

  @@index([status, createdAt])
}

model Regulation {
  id        String          @id @default(cuid())
  title     String
  type      RegulationType
  number    String?
  summary   String?
  sourceUrl String?
  fileUrl   String?
  fullText  String?
  issuedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id           String     @id @default(cuid())
  regulationId String
  content      String
  pageNumber   Int?
  chunkIndex   Int
  embeddingId  String?
  createdAt    DateTime   @default(now())
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
}

model NormativeDocument {
  id              String             @id
  title           String
  documentType    String
  ordinanceNumber String?
  versionDate     DateTime?
  jurisdiction    String
  sourceName      String
  sourcePath      String?
  status          NormativeStatus    @default(HISTORICAL_REFERENCE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  chapters        NormativeChapter[]
  articles        NormativeArticle[]
  ordinances      Ordinance[]        @relation("SourceNormativeDocument")

  @@index([ordinanceNumber])
  @@index([versionDate])
}

model NormativeChapter {
  id            String             @id
  documentId    String
  chapterNumber String
  title         String
  description   String?
  displayOrder  Int
  document      NormativeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  articles      NormativeArticle[]

  @@unique([documentId, chapterNumber])
  @@index([documentId, displayOrder])
}

model NormativeArticle {
  id                String                @id
  documentId        String
  chapterId         String?
  articleNumber     String
  title             String?
  content           String
  normalizedContent String
  metadata          Json                  @default("{}")
  status            NormativeStatus       @default(HISTORICAL_REFERENCE)
  displayOrder      Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  document          NormativeDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapter           NormativeChapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  versions          ArticleVersion[]
  sourceDistricts   District[]
  landUseRules      DistrictLandUseRule[]
  links             NormativeLink[]

  @@unique([documentId, articleNumber])
  @@index([documentId, displayOrder])
  @@index([chapterId])
}

model Ordinance {
  id               String             @id
  number           String             @unique
  title            String
  description      String?
  sanctionDate     DateTime?
  effectiveDate    DateTime?
  status           NormativeStatus    @default(UNKNOWN)
  sourceDocumentId String?
  sourceDocument   NormativeDocument? @relation("SourceNormativeDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  articleVersions  ArticleVersion[]
}

model ArticleVersion {
  id            String              @id @default(cuid())
  articleId     String
  ordinanceId   String?
  content       String
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  changeType    NormativeChangeType
  notes         String?
  article       NormativeArticle    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ordinance     Ordinance?          @relation(fields: [ordinanceId], references: [id], onDelete: SetNull)

  @@index([articleId, effectiveFrom])
  @@index([ordinanceId])
}

model District {
  id                   String                   @id
  code                 String                   @unique
  name                 String?
  category             String?
  description          String?
  characterDescription String?
  geometry             Unsupported("geometry")?
  sourceArticleId      String?
  sourceArticle        NormativeArticle?        @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)
  landUseRules         DistrictLandUseRule[]
  projects             Project[]

  @@index([sourceArticleId])
}

model LandUse {
  id          String                @id @default(cuid())
  name        String
  category    String?
  description String?
  rules       DistrictLandUseRule[]

  @@unique([name, category])
}

model DistrictLandUseRule {
  id                  String            @id @default(cuid())
  districtId          String
  landUseId           String
  status              LandUseRuleStatus @default(UNKNOWN)
  conditions          String?
  parkingRequirements String?
  loadingRequirements String?
  sourceArticleId     String?
  sourceReference     String?
  district            District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  landUse             LandUse           @relation(fields: [landUseId], references: [id], onDelete: Cascade)
  sourceArticle       NormativeArticle? @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)

  @@unique([districtId, landUseId, sourceReference])
  @@index([sourceArticleId])
}

model NormativeLink {
  id               String                    @id @default(cuid())
  sourceType       String
  sourceId         String
  articleId        String
  relationshipType NormativeRelationshipType
  notes            String?
  createdBy        String?
  createdAt        DateTime                  @default(now())
  article          NormativeArticle          @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, articleId, relationshipType])
  @@index([articleId])
  @@index([sourceType, sourceId])
}

model City {
  id          String           @id @default(cuid())
  name        String
  province    String?
  country     String
  population  Int?
  areaKm2     Float?
  density     Float?
  climate     String?
  description String?
  similarity  Int              @default(0)
  caseStudies CaseStudy[]
  indicators  UrbanIndicator[]
}

model CaseStudy {
  id        String   @id @default(cuid())
  cityId    String
  title     String
  problem   String
  solution  String
  results   String?
  cost      String?
  sourceUrl String?
  tags      String[]
  createdAt DateTime @default(now())
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model UrbanIndicator {
  id        String  @id @default(cuid())
  cityId    String
  name      String
  value     Float
  unit      String
  year      Int
  sourceUrl String?
  city      City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model UrbanLayer {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  description      String?
  geometryType     GeometryType
  visibleByDefault Boolean      @default(false)
  features         MapFeature[]
}

model MapFeature {
  id          String                  @id @default(cuid())
  layerId     String
  name        String
  description String?
  properties  Json                    @default("{}")
  geometry    Unsupported("geometry")
  layer       UrbanLayer              @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([layerId])
}

model Proposal {
  id                   String                @id @default(cuid())
  title                String
  description          String
  status               ProposalStatus        @default(DRAFT)
  source               ProposalSource        @default(CITIZEN)
  latitude             Float?
  longitude            Float?
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            User?                 @relation(fields: [createdById], references: [id])
  comments             Comment[]
  citizenContributions CitizenContribution[]
  votes                Vote[]
  projects             Project[]
  debates              Debate[]
}

model CitizenContribution {
  id          String                    @id @default(cuid())
  kind        CitizenContributionKind
  name        String
  dni         String
  zone        String
  text        String
  fileName    String?
  axis        String
  /// Por qué Migue sugirió ese eje, con el artículo en el que se apoyó.
  axisReason  String?
  /// Tema del CPU con el que se relaciona un aporte "Fuera del alcance del CPU".
  /// El Código no lo regula, pero lo roza: basura -> Usos del suelo (Art. 20).
  /// Guarda el label del tema (ver OUT_OF_SCOPE_RELATIONS). Null = sin puente.
  relatedTopic String?
  /// false = eje sugerido por Migue, todavía sin revisar. true = lo confirmó una persona.
  axisConfirmed Boolean                 @default(false)
  confidence  String
  status      CitizenContributionStatus @default(NEW)
  /// Autor del aporte. Nullable: los aportes anteriores al login obligatorio no lo tienen.
  /// SetNull y no Cascade: si se borra la cuenta, el aporte queda para el municipio.
  userId      String?
  proposalId  String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  proposal    Proposal?                 @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([kind])
  @@index([status])
  @@index([proposalId])
  @@index([userId])
  @@index([axis])
  @@index([relatedTopic])
}

model Comment {
  id         String   @id @default(cuid())
  proposalId String
  userId     String
  body       String
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vote {
  id         String   @id @default(cuid())
  proposalId String
  userId     String
  value      Int      @default(1)
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
}

model CabinetMeeting {
  id           String        @id @default(cuid())
  title        String
  meetingDate  DateTime
  area         String?
  participants String[]
  notes        String?
  ideas        CabinetIdea[]
  createdAt    DateTime      @default(now())
}

model CabinetIdea {
  id          String         @id @default(cuid())
  meetingId   String
  title       String
  description String
  status      IdeaStatus     @default(NEW)
  proposalId  String?
  projectId   String?
  createdAt   DateTime       @default(now())
  meeting     CabinetMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// Registro de consultas a Migue: la materia prima del futuro panel "qué
// pregunta la gente". answered=false marca los huecos de conocimiento: una
// consulta normativa que el RAG no pudo respaldar con evidencia.
model AiQuery {
  id        String   @id @default(cuid())
  question  String
  answer    String?
  sources   Json     @default("[]")
  answered  Boolean  @default(true)
  normative Boolean  @default(false)
  mode      String?
  module    String?
  createdAt DateTime @default(now())

  @@index([answered, createdAt])
}

model KnowledgeSource {
  id          String              @id @default(cuid())
  kind        KnowledgeSourceKind
  externalId  String?
  title       String
  sourceUrl   String?
  filePath    String?
  mimeType    String?
  status      ProcessingStatus    @default(PENDING)
  rawText     String?
  summary     String?
  metadata    Json                @default("{}")
  wordCount   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  processedAt DateTime?
  chunks      KnowledgeChunk[]

  @@unique([kind, externalId])
  @@index([kind])
  @@index([status])
}

model KnowledgeChunk {
  id            String                      @id @default(cuid())
  sourceId      String
  chunkIndex    Int
  content       String
  tokenEstimate Int                         @default(0)
  metadata      Json                        @default("{}")
  embedding     Unsupported("vector(384)")?
  createdAt     DateTime                    @default(now())
  source        KnowledgeSource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, chunkIndex])
  @@index([sourceId, chunkIndex])
}

model Meeting {
  id                 String               @id @default(cuid())
  title              String
  kind               MeetingKind          @default(MEETING)
  status             ProcessingStatus     @default(PENDING)
  occurredAt         DateTime?
  location           String?
  description        String?
  language           String               @default("es")
  metadata           Json                 @default("{}")
  /// Registro de audiencias: estado y origen de la ficha. Opcionales para no
  /// romper los Meeting genericos (reuniones/actas) que no son audiencias.
  hearingStatus      HearingStatus?
  hearingSource      HearingSource?
  modality           String?
  /// Audiencia en vivo: el codigo nuevo (Fabrica de Normas) que se debate.
  /// Acota el macheo en vivo a las normas de esa reforma.
  reformId           String?
  reform             NormativeReform?     @relation(fields: [reformId], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  mediaFiles         MeetingMedia[]
  participants       MeetingParticipant[]
  transcriptSegments TranscriptSegment[]
  analyses           MeetingAnalysis[]
  insights           MeetingInsight[]
  actionItems        MeetingActionItem[]
  projectAttachments ProjectAttachment[]
  normMatches        HearingNormMatch[]
  debates            Debate[]
  /// Resumen ejecutivo PUBLICADO para la ciudadania. El PDF se genera con IA y
  /// lo revisa una persona antes de publicarlo: el portal solo muestra este
  /// archivo ya aprobado, nunca dispara una generacion.
  publicSummaryUrl   String?
  /// Ruta en Supabase Storage, para reemplazarlo o borrarlo al despublicar.
  publicSummaryPath  String?
  publicSummaryAt    DateTime?
  /// Presente solo si kind=PUBLIC_HEARING.
  hearingRecord      HearingRecord?

  @@index([reformId])
  /// El registro de audiencias filtra por kind y ordena por fecha; los conteos
  /// del board agrupan por kind + estado. Sin estos indices ambas consultas
  /// escanean la tabla entera de reuniones.
  @@index([kind, occurredAt(sort: Desc)])
  @@index([kind, hearingStatus])
}

/// Cruce en vivo audiencia <-> mininorma: que norma del codigo nuevo se esta
/// discutiendo, con que postura y con que fragmento de la transcripcion.
model HearingNormMatch {
  id         String             @id @default(cuid())
  meetingId  String
  projectId  String
  fragment   String
  stance     HearingMatchStance @default(MENTION)
  confidence Float              @default(0)
  atMs       Int?
  createdAt  DateTime           @default(now())
  meeting    Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  norm       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([projectId])
}

enum HearingMatchStance {
  SUPPORT
  OPPOSE
  CHANGE_REQUEST
  MENTION
}

enum HearingStatus {
  SCHEDULED
  LIVE
  PROCESSING
  COMPLETED
  CANCELLED
}

enum HearingSource {
  LIVE
  YOUTUBE
  UPLOAD
  MANUAL
}

/// Archivos de audio/video de una reunion. Hoy lo usa la grabacion de las
/// audiencias en vivo, que NO guarda un archivo unico sino un tramo por fila:
/// las filas son ademas la cola de trabajo de la transcripcion (status PENDING
/// -> READY, o ERROR con el motivo en errorMessage).
model MeetingMedia {
  id           String           @id @default(cuid())
  meetingId    String
  kind         MediaKind
  fileName     String
  storagePath  String
  mimeType     String
  sizeBytes    BigInt?
  durationSec  Int?
  /// Orden del tramo dentro de la grabacion, desde 0. Null en un archivo unico.
  partIndex    Int?
  /// Milisegundos desde el inicio de la grabacion hasta el inicio de ESTE tramo.
  /// Es lo que se le pasa a Whisper como offset para que los timestamps de cada
  /// tramo caigan en el minuto real de la audiencia. No se puede derivar del
  /// orden: los tramos se solapan a proposito y sumar duraciones acumula error.
  offsetMs     Int?
  status       ProcessingStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime         @default(now())
  meeting      Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Un archivo del bucket = UNA fila. El registro de un tramo se reintenta
  /// (la confirmacion se pierde en la red mas seguido de lo que parece), y sin
  /// esta restriccion dos reintentos concurrentes pasaban los dos por el
  /// "existe?" y creaban dos filas para el mismo audio: como las filas SON la
  /// cola de trabajo, el mismo tramo se transcribia dos veces.
  @@unique([meetingId, storagePath])
  @@index([meetingId])
  @@index([status])
}

model MeetingParticipant {
  id           String  @id @default(cuid())
  meetingId    String
  displayName  String
  role         String?
  email        String?
  institution  String?
  /// Vecino, Colegio profesional, Concejal... Quien habla en nombre de quien.
  actorType    String?
  attended     Boolean @default(false)
  /// Sintesis de lo que dijo. La cita textual vive en TranscriptSegment.
  intervention String?
  metadata     Json    @default("{}")
  meeting      Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model TranscriptSegment {
  id            String   @id @default(cuid())
  meetingId     String
  participantId String?
  speakerLabel  String?
  startMs       Int
  endMs         Int
  content       String
  confidence    Float?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

