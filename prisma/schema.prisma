  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  CpuMessage[]

  @@index([ownerKey, archived, updatedAt])
}

model CpuMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String
  content        String
  citations      Json            @default("[]")
  retrieved      Json            @default("[]")
  isError        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  conversation   CpuConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Project {
  id            String              @id @default(cuid())
  code          String              @unique
  title         String
  summary       String
  status        ProjectStatus       @default(DRAFT)
  stage         ProjectStage        @default(FORMULATION)
  source        ProposalSource      @default(TECHNICAL_TEAM)
  areas         MunicipalArea[]
  requiresEIA   Boolean             @default(false)
  eiaNotes      String?
  proposalId    String?
  proposal      Proposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  latitude      Float?
  longitude     Float?
  addressLabel  String?
  districtId    String?
  district      District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  officialNotes String?
  createdById   String?
  createdBy     User?               @relation(fields: [createdById], references: [id])
  /// Quien redacto, dentro de la cuenta. Las direcciones entran con una cuenta
  /// institucional compartida ("Direccion IA"), asi que createdBy no alcanza para
  /// saber que persona escribio la norma. No reemplaza a createdById: ese sigue
  /// siendo el registro autenticado y no falsificable; este es el nombre visible.
  authorName    String?
  /// Fabrica de Normas: un Project con reformId es una NORMA (articulo) de un
  /// codigo nuevo en construccion. title = titulo de la norma, summary = objeto.
  reformId      String?
  reform        NormativeReform?    @relation(fields: [reformId], references: [id], onDelete: SetNull)
  /// Numero tentativo de la norma dentro del codigo nuevo (ej. "12").
  articleNumber String?
  /// Texto del articulado redactado: la norma en si.
  articleText   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  diagnoses     ProjectDiagnosis[]
  budgetItems   ProjectBudgetItem[]
  attachments   ProjectAttachment[]
  cabinetIdeas  CabinetIdea[]
  hearingMatches HearingNormMatch[]
  hearingRecords HearingRecord[]
  opinions      NormOpinion[]
  supports      NormSupport[]
  debates       Debate[]

  @@index([status])
  @@index([stage])
  @@index([createdAt])
  @@index([proposalId])
  @@index([reformId])
}

model ProjectDiagnosis {
  id            String           @id @default(cuid())
  projectId     String
  version       Int              @default(1)
  feasibility   FeasibilityLevel
  scope         String
  objective     String
  analysis      String
  actions       Json             @default("[]")
  risks         Json             @default("[]")
  citedArticles Json             @default("[]")
  /// Texto de articulo sugerido por la IA, apoyado en el codigo viejo. Es una
  /// sugerencia editable, nunca la palabra final.
  proposedText  String?
  model         String?
  editedByHuman Boolean          @default(false)
  createdAt     DateTime         @default(now())
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProjectBudgetItem {
  id            String         @id @default(cuid())
  projectId     String
  concept       String
  costType      BudgetCostType
  baseAmount    Decimal        @db.Decimal(14, 2)
  multiplier    Float          @default(1)
  fundingSource String?
  amount        Decimal        @db.Decimal(14, 2)
  createdAt     DateTime       @default(now())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectAttachment {
  id          String   @id @default(cuid())
  projectId   String
  kind        String
  name        String
  excerpt     String?
  meetingId   String?
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  /// Archivo real en Supabase Storage. Todos opcionales: los adjuntos previos
  /// solo guardaban un excerpt de texto, sin archivo.
  ///
  /// OJO: varias normas salidas del mismo PDF comparten storagePath — el
  /// archivo NO se duplica. Antes de borrarlo del bucket hay que verificar que
  /// ningun otro ProjectAttachment ni ReformDocument lo apunte.
  storagePath String?
  url         String?
  mimeType    String?
  sizeBytes   Int?
  /// Paginas del documento de origen que respaldan esta norma.
  sourcePages Int[]    @default([])
  uploadedBy  String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([storagePath])
}

// Un "codigo nuevo" en construccion: la fabrica que agrupa normas (articulos)
// que se redactan consultando el CPU 2014.
model NormativeReform {
  id          String       @id @default(cuid())
  code        String       @unique
  title       String
  description String?
  status      ReformStatus @default(DRAFT)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  norms       Project[]
  hearings    Meeting[]
  documents   ReformDocument[]

  @@index([status])
  @@index([createdAt])
}

/// Documento aportado a la reforma (PDF de una agrupacion, colegio, universidad
/// u ONG). Espeja a HearingDocument: el archivo vive en Supabase Storage y aca
/// queda el registro con su link.
///
/// Existe con independencia de que haya producido normas: un PDF que resulta
/// ser un encuadre institucional o una ponencia metodologica se guarda igual,
/// como antecedente de la reforma. Es el caso mas frecuente, no la excepcion.
model ReformDocument {
  id           String   @id @default(cuid())
  reformId     String
  name         String
  type         String
  url          String?
  /// Ruta del objeto en el bucket de normas: permite borrar el archivo real.
  storagePath  String?
  sizeBytes    Int?
  pageCount    Int?
  /// Que es este documento, en 2-4 oraciones (propuesto por IA, editable).
  summary      String?
  /// PROPUESTA_NORMATIVA | DIAGNOSTICO_TECNICO | PRESENTACION_INSTITUCIONAL |
  /// PONENCIA_ACADEMICA | OTRO
  documentKind String?
  /// Hash del archivo, para avisar que ese PDF ya se habia subido. Con 15
  /// archivos cargados de a uno, duplicar es facil.
  sha256       String?
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  reform       NormativeReform @relation(fields: [reformId], references: [id], onDelete: Cascade)

  @@index([reformId])
  @@index([sha256])
}

enum ReformStatus {
  DRAFT
  IN_REVIEW
  CONSOLIDATED
  ARCHIVED
}

// Devolucion interna del equipo municipal sobre una norma ya presentada.
// No se reutiliza Comment porque Comment cuelga de Proposal (participacion
// ciudadana): son dos conversaciones distintas, con distinto publico.
model NormOpinion {
  id         String   @id @default(cuid())
  /// La norma opinada: un Project con reformId.
  projectId  String
  /// Autor. SetNull para conservar la devolucion si se borra la cuenta.
  userId     String?
  /// Snapshot del nombre al momento de opinar: la opinion sigue identificada
  /// aunque el User desaparezca y userId quede en null.
  authorName String
  body       String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId])
}

// Apoyo u objecion del equipo municipal a una norma. Interno, no ciudadano.
// Tampoco reutiliza Vote, que cuelga de Proposal.
model NormSupport {
  id        String   @id @default(cuid())
  projectId String
  /// Cuenta desde la que se emitio el voto. Ya NO identifica al votante: varias
  /// personas comparten la cuenta institucional de su direccion.
  userId    String
  /// PROVISORIO. Quien vota, declarado en pantalla. Es lo que hace que dos
  /// personas de la misma direccion puedan votar la misma norma.
  ///
  /// No es verificable: cualquiera con la cuenta abierta puede votar eligiendo
  /// otro nombre. El conteo sirve como termometro de trabajo interno, no como
  /// votacion formal, y no deberia citarse como tal. La solucion real es una
  /// cuenta por persona, y cuando exista este campo se reemplaza por userId.
  voterName String
  /// +1 = a favor, -1 = en contra. La API valida el par; Postgres no tiene
  /// enum para esto y un CHECK complicaria el upsert.
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un voto por nombre y norma: cambiar de opinion actualiza el mismo registro.
  @@unique([projectId, voterName])
  @@index([projectId])
}

