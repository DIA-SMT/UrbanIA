NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Pooler de Supabase en modo TRANSACCION: puerto 6543 y pgbouncer=true. Es el
# unico modo que aguanta serverless. En modo sesion (5432) cada cliente reserva
# una conexion real de Postgres, el tope son 15 y produccion se cae con
# EMAXCONNSESSION apenas hay unas pocas lambdas vivas.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# La misma cadena con el puerto 5432 (modo sesion). Solo la usan las migraciones,
# que no pueden ir por el pooler de transacciones. La app nunca la toca.
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET=""
# Tamano del pool de Prisma. Default: 5 (local) / 3 (serverless). Subirlo
# acelera todo lo que corre en Promise.all, pero en serverless se multiplica por
# la cantidad de instancias vivas. Contra el pooler de transacciones eso no
# reserva conexiones reales; contra el de sesion habria que bajarlo a 1.
DATABASE_CONNECTION_LIMIT=""

# Documentos adjuntos de audiencias (Supabase Storage). Crear un bucket PUBLICO
# y pegar su nombre aca (default: "audiencias"). La service role key es opcional
# pero recomendada: los uploads server-side saltean las politicas RLS del bucket.
SUPABASE_HEARINGS_BUCKET="audiencias"
SUPABASE_SERVICE_ROLE_KEY=""

# PDFs aportados a la Fabrica de Normas (importador de /normas/[id]/importar).
# Bucket PUBLICO, separado del de audiencias. La subida va directo del browser
# con signed URL, asi que la service role key de arriba es la que las firma.
SUPABASE_NORMS_BUCKET="normas"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Modelo mas capaz, para consultas normativas y lectura de documentos.
OPENROUTER_CPU_MODEL="openai/gpt-4o"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="UrbanIA"
# Transcripcion de audiencias (Whisper via OpenRouter). Opcional: default openai/whisper-1
OPENROUTER_TRANSCRIPTION_MODEL="openai/whisper-1"
# Identidad municipal Cidituc. Mantener false hasta probar el callback completo.
CIDITUC_ENABLED="false"
CIDITUC_DERIVADOR_URL="http://localhost:5174"
CIDITUC_API_URL="http://localhost:3050"
CIDITUC_CALLBACK_URL="http://localhost:3000/auth/cidituc/callback"
# JWT_SECRET_KEY del cidituc-backend (el mismo que hub-ia pone en
# CIDITUC_JWT_SECRET). Permite verificar la firma del token localmente, sin
# depender de la red ni del certificado del backend. Si falta, la validacion la
# hace solo el backend, como antes.
CIDITUC_JWT_SECRET=""
# OPCIONAL. Certificado(s) PEM extra para validar el TLS del backend de Cidituc.
# estadisticas.smt.gob.ar:5000 no manda el intermedio de Sectigo y desde un
# runtime Linux (Vercel) el handshake falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE.
# Ese intermedio ya viene embebido en lib/auth/identity/cidituc-https.ts; esta
# variable solo hace falta para reemplazarlo sin un deploy (por ejemplo si la CA
# rota). Nunca desactivar la verificacion: el token viajaria sin proteccion.
CIDITUC_CA_PEM=""
